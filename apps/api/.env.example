# Copy to .env and fill in DATABASE_URL from Railway dashboard
# All other values work as-is for local dev

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

JWT_SECRET=karysm-dev-secret
NODE_ENV=development
DEMO_OTP=1234

# Optional — leave blank to skip in dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=
# Set these after fine-tuning completes — falls back to gpt-4o if unset
OPENAI_FINETUNE_SKIN_MODEL=
OPENAI_FINETUNE_HAIR_MODEL=
