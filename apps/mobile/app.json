{
  "expo": {
    "name": "Karysm",
    "slug": "karysm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "karysm",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAFAF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karysm.app"
    },
    "android": {
      "package": "com.karysm.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"]
  }
}
