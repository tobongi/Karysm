{
  "name": "Karysm",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "proxy": "node scripts/dev-proxy.js",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:studio": "pnpm --filter @karysm/db studio",
    "db:seed": "pnpm --filter @karysm/db db:seed",
    "test": "pnpm --filter @karysm/api test",
    "test:e2e": "node node_modules/.pnpm/@playwright+test@1.60.0/node_modules/@playwright/test/node_modules/.bin/playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.59.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
