generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS ====================

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?
  name          String
  avatar        String?
  role          UserRole  @default(CLIENT)
  isVerified    Boolean   @default(false)
  locale        String    @default("fr")
  lat           Float?
  lng           Float?
  pushToken     String?

  provider      Provider?
  bookings      Booking[]       @relation("ClientBookings")
  reviews       Review[]
  favorites     Favorite[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  requests      BeautyRequest[] @relation("ClientRequests")
  skinAnalyses  SkinAnalysis[]
  hairAnalyses  HairAnalysis[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ==================== PROVIDERS ====================

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Provider {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  displayName     String
  slug            String         @unique
  bio             String?
  status          ProviderStatus @default(PENDING)

  city            String
  commune         String?
  address         String?
  lat             Float?
  lng             Float?
  mobileRadius    Int            @default(10)
  isMobile        Boolean        @default(true)

  whatsappNumber  String?
  instagramHandle String?
  tiktokHandle    String?

  payoutPhone     String?
  currency        String         @default("CDF")

  idVerified      Boolean        @default(false)
  kycStatus       String         @default("NOT_STARTED") // NOT_STARTED, PENDING, APPROVED, REJECTED
  portfolioCount  Int            @default(0)

  avgRating       Float          @default(0)
  totalReviews    Int            @default(0)
  totalBookings   Int            @default(0)
  responseRate    Float          @default(0)

  googleCalendarId   String?
  googleRefreshToken String?
  googleCalendarSync Boolean      @default(false)

  services        Service[]
  availability    Availability[]
  portfolio       PortfolioItem[]
  bookings        Booking[]       @relation("ProviderBookings")
  wallet          ProviderWallet?
  kycDocuments    KycDocument[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([city])
  @@index([status])
  @@index([avgRating])
  @@map("providers")
}

// ==================== SERVICES ====================

model ServiceCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  nameEn   String?
  icon     String?
  slug     String    @unique
  sortOrder Int      @default(0)

  services Service[]

  @@map("service_categories")
}

model Service {
  id           String          @id @default(cuid())
  providerId   String
  provider     Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  durationMin  Int
  priceMin     Int
  priceMax     Int?
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  socialLinks  String[]        // URLs Instagram/TikTok de prestations passées

  bookings     Booking[]

  @@index([providerId])
  @@index([categoryId])
  @@map("services")
}

// ==================== AVAILABILITY ====================

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Availability {
  id          String    @id @default(cuid())
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  isActive    Boolean   @default(true)

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
  @@map("availability")
}

model AvailabilityException {
  id          String    @id @default(cuid())
  providerId  String
  date        DateTime  @db.Date
  isBlocked   Boolean   @default(true)
  startTime   String?
  endTime     String?
  reason      String?

  @@unique([providerId, date])
  @@index([providerId])
  @@map("availability_exceptions")
}

// ==================== BOOKINGS ====================

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DEPOSIT_PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  DISPUTED
}

model Booking {
  id              String        @id @default(cuid())
  ref             String        @unique
  clientId        String
  client          User          @relation("ClientBookings", fields: [clientId], references: [id])
  providerId      String
  provider        Provider      @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])

  date            DateTime      @db.Date
  startTime       String
  endTime         String

  locationType    String        @default("CLIENT")
  locationAddress String?
  locationLat     Float?
  locationLng     Float?

  agreedPrice     Int
  currency        String        @default("CDF")
  depositAmount   Int?
  depositPaid     Boolean       @default(false)

  transportRequested Boolean    @default(false)
  transportId     String?       @unique
  transport       TransportRequest?

  status          BookingStatus @default(REQUESTED)
  cancelReason    String?
  cancelledBy     String?

  clientNotes     String?
  providerNotes   String?

  paymentIntents  PaymentIntent[]
  review          Review?

  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
  @@index([providerId])
  @@index([date])
  @@index([status])
  @@map("bookings")
}

// ==================== PAYMENTS ====================

enum PaymentIntentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model PaymentIntent {
  id            String              @id @default(cuid())
  bookingId     String
  booking       Booking             @relation(fields: [bookingId], references: [id])
  amount        Int
  currency      String              @default("CDF")
  type          String              @default("DEPOSIT")
  method        String              @default("MOMO")
  status        PaymentIntentStatus @default(CREATED)
  externalRef   String?
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([bookingId])
  @@index([externalRef])
  @@map("payment_intents")
}

model ProviderWallet {
  id               String    @id @default(cuid())
  providerId       String    @unique
  provider         Provider  @relation(fields: [providerId], references: [id])
  availableBalance Int       @default(0)
  pendingBalance   Int       @default(0)
  currency         String    @default("CDF")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions     WalletTransaction[]
  payouts          Payout[]

  @@map("provider_wallets")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       ProviderWallet @relation(fields: [walletId], references: [id])
  type         String
  amount       Int
  balanceAfter Int
  bookingId    String?
  description  String?
  createdAt    DateTime @default(now())

  @@index([walletId])
  @@map("wallet_transactions")
}

model Payout {
  id               String   @id @default(cuid())
  walletId         String
  wallet           ProviderWallet @relation(fields: [walletId], references: [id])
  providerId       String
  amount           Int
  fee              Int
  grossAmount      Int
  currency         String   @default("CDF")
  status           String   @default("PENDING")
  destinationPhone String
  externalRef      String?
  failureReason    String?
  processedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([providerId])
  @@index([status])
  @@map("payouts")
}

// ==================== REVIEWS ====================

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId   String
  client     User     @relation(fields: [clientId], references: [id])
  providerId String
  rating     Int
  comment    String?
  photos     String[]
  tags       String[]
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@map("reviews")
}

// ==================== PORTFOLIO ====================

model PortfolioItem {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  imageUrl    String
  caption     String?
  serviceTag  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([providerId])
  @@map("portfolio_items")
}

// ==================== FAVORITES ====================

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@map("favorites")
}

// ==================== TRANSPORT ====================

enum TransportStatus {
  REQUESTED
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model TransportRequest {
  id             String          @id @default(cuid())
  bookingId      String          @unique
  booking        Booking         @relation(fields: [bookingId], references: [id])
  method         String          @default("WHATSAPP")
  pickupAddress  String
  pickupLat      Float?
  pickupLng      Float?
  dropoffAddress String
  dropoffLat     Float?
  dropoffLng     Float?
  estimatedCost  Int
  actualCost     Int?
  status         TransportStatus @default(REQUESTED)
  driverPhone    String?
  driverName     String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("transport_requests")
}

// ==================== KYC ====================

model KycDocument {
  id             String    @id @default(cuid())
  providerId     String
  provider       Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type           String    // ID_FRONT, ID_BACK, SELFIE_WITH_ID
  imageUrl       String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectedReason String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([providerId])
  @@index([status])
  @@map("kyc_documents")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String    // BOOKING_REQUESTED, BOOKING_CONFIRMED, BOOKING_COMPLETED, BOOKING_CANCELLED, REVIEW_RECEIVED, KYC_APPROVED, KYC_REJECTED
  title     String
  body      String
  data      Json?     // { bookingId, providerId, etc. }
  readAt    DateTime?
  pushSent  Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==================== ADMIN ====================

model Admin {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String   @default("SUPPORT")
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("admins")
}

// ==================== BEAUTY REQUESTS (Upwork mode) ====================

enum BeautyRequestStatus {
  OPEN
  IN_REVIEW
  ACCEPTED
  EXPIRED
  CANCELLED
  COMPLETED
}

model BeautyRequest {
  id              String              @id @default(cuid())
  clientId        String
  client          User                @relation("ClientRequests", fields: [clientId], references: [id])

  title           String
  description     String
  categoryId      String

  photos          String[]
  selfieUrl       String?

  budgetMin       Int
  budgetMax       Int
  currency        String              @default("CDF")
  preferredDate   DateTime?           @db.Date
  flexibleDate    Boolean             @default(false)
  locationType    String              @default("CLIENT")
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  city            String

  status          BeautyRequestStatus @default(OPEN)

  proposals       Proposal[]

  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([clientId])
  @@index([city])
  @@index([status])
  @@map("beauty_requests")
}

enum ProposalStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Proposal {
  id              String          @id @default(cuid())
  requestId       String
  request         BeautyRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId      String

  price           Int
  currency        String          @default("CDF")
  message         String
  estimatedDuration Int
  portfolioSamples String[]

  status          ProposalStatus  @default(PENDING)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([requestId, providerId])
  @@index([requestId])
  @@index([providerId])
  @@map("proposals")
}

// ==================== AI ANALYSIS ====================

model SkinAnalysis {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  selfieUrl         String

  // Monk Scale
  monkTone          Int?     // 1-10
  undertone         String?  // WARM, COOL, NEUTRAL

  // LAB / ITA
  labL              Float?
  labA              Float?
  labB              Float?
  itaAngle          Float?
  melaninIndex      Float?

  // Conditions (0-100)
  hydration         Int?
  sebum             Int?
  pores             Int?
  wrinkles          Int?
  spots             Int?
  acne              Int?
  hyperpigmentation Int?
  uniformity        Int?

  overallScore      Int?
  recommendations   Json?
  rawResponse       Json?
  processingTime    Int?
  consentDataset    Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@map("skin_analyses")
}

model HairAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  photoUrl        String

  hairType        String?  // 3A, 3B, 3C, 4A, 4B, 4C
  porosity        String?  // LOW, MEDIUM, HIGH
  density         String?  // LOW, MEDIUM, HIGH
  thickness       String?  // FINE, MEDIUM, COARSE
  dryness         Int?
  elasticity      Int?
  shrinkage       Int?
  scalpCondition  String?  // HEALTHY, DRY, OILY, FLAKY
  currentStyle    String?  // AFRO, BRAIDS, CORNROWS, LOCS, TWA, etc.

  overallScore    Int?
  recommendations Json?
  rawResponse     Json?
  processingTime  Int?
  consentDataset  Boolean  @default(false)

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("hair_analyses")
}
